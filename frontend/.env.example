# Copy this file to frontend/.env for local development.
# Never put real secrets, passwords, API keys, or tokens in this file.

# --- Required ---
# Local SQLite. Production must use a PostgreSQL URL in DATABASE_URL only.
# The app does not read SUPABASE_* variables.
DATABASE_URL="file:./dev.db"
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=

# --- Internal ReviveLead admin (comma-separated). Agency OWNER/ADMIN is not enough. ---
REVIVELEAD_ADMIN_EMAILS=
REVIVELEAD_ADMIN_USER_IDS=

# --- Clerk (production auth; Google SSO is configured in the Clerk Dashboard) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"
# Production only. Must match Clerk Dashboard → Configure → Domains → proxy URL.
NEXT_PUBLIC_CLERK_PROXY_URL="/__clerk"

# --- Optional AI (openai | puter | heuristic) ---
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
PUTER_API_KEY=

# --- Optional email ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Optional billing (Razorpay is the production provider) ---
# Test mode: rzp_test_... keys + test plan ids + test webhook secret.
# Live mode: rzp_live_... keys. Do not commit real secrets. Production is not auto-enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=

# --- Optional billing fallback (Paddle) ---
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT="sandbox"
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_ENTERPRISE=
